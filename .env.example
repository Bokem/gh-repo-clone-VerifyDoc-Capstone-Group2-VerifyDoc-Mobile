# Base URL for the VerifyDoc backend API
# Local dev example: http://localhost:4000
# Staging/prod example: https://api.verifydoc.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# API version path segment, matches backend contract (/api/v1/...)
EXPO_PUBLIC_API_VERSION=v1

# Toggle mock/offline mode during early dev before backend endpoints are live
EXPO_PUBLIC_USE_MOCK_API=true

# Timeout (ms) for verification lookup requests
EXPO_PUBLIC_API_TIMEOUT_MS=10000